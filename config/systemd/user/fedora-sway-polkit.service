[Unit]
Description=Independent LXQt polkit authentication agent
PartOf=fedora-sway-session.target
After=graphical-session.target pipewire.service wireplumber.service

[Service]
ExecStart=/usr/libexec/lxqt-policykit-agent
Restart=on-failure
RestartSec=1

[Install]
WantedBy=fedora-sway-session.target
