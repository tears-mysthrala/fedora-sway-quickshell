[Unit]
Description=Wayland clipboard history
PartOf=fedora-sway-session.target
After=graphical-session.target

[Service]
ExecStart=/bin/sh -c '/usr/bin/wl-paste --type text --watch /usr/bin/cliphist store & /usr/bin/wl-paste --type image --watch /usr/bin/cliphist store & wait'
Restart=on-failure
RestartSec=1

[Install]
WantedBy=fedora-sway-session.target
